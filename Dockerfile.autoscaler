FROM golang:1.25-alpine AS builder

# Install build dependencies for CGO
RUN apk add --no-cache gcc musl-dev sqlite-dev

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build autoscaler
RUN CGO_ENABLED=1 GOOS=linux go build -o autoscaler ./cmd/autoscaler

FROM alpine:latest

RUN apk --no-cache add ca-certificates sqlite

WORKDIR /app

COPY --from=builder /build/autoscaler .

CMD ["./autoscaler"]
